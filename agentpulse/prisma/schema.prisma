generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Société ──────────────────────────────────────────────────────────────────

model Company {
  id             String   @id @default(cuid())
  name           String
  logoUrl        String?
  primaryColor   String   @default("#3B82F6")
  secondaryColor String   @default("#10B981")
  objectives     Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users       User[]
  prospects   Prospect[]
  policies    Policy[]
  commissions Commission[]
  snapshots   AgentSnapshot[]

  @@map("companies")
}

// ─── Utilisateur ──────────────────────────────────────────────────────────────

model User {
  id             String     @id @default(cuid())
  email          String     @unique
  name           String
  phone          String?
  passwordHash   String
  role           Role       @default(AGENT)
  status         UserStatus @default(TRIAL)
  trialExpiresAt DateTime?
  commissionRate Float      @default(5.0)
  companyId      String
  supervisorId   String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  company    Company @relation(fields: [companyId], references: [id])
  supervisor User?   @relation("SupervisorAgents", fields: [supervisorId], references: [id])
  agents     User[]  @relation("SupervisorAgents")

  prospects           Prospect[]
  policies            Policy[]
  commissions         Commission[]
  approvedCommissions Commission[] @relation("ApprovedCommissions")
  activities          Activity[]
  snapshots           AgentSnapshot[]

  accounts Account[]
  sessions Session[]

  @@map("users")
}

// ─── NextAuth ─────────────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── Prospect ─────────────────────────────────────────────────────────────────

model Prospect {
  id             String        @id @default(cuid())
  firstName      String
  lastName       String
  phone          String
  email          String?
  job            String?
  estimatedPrime Float?
  stage          ProspectStage @default(CONTACT)
  notes          String?
  agentId        String
  companyId      String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  agent      User       @relation(fields: [agentId], references: [id])
  company    Company    @relation(fields: [companyId], references: [id])
  policies   Policy[]
  activities Activity[]

  @@map("prospects")
}

// ─── Police ───────────────────────────────────────────────────────────────────

model Policy {
  id           String       @id @default(cuid())
  policyNumber String       @unique
  productType  String
  premium      Float
  startDate    DateTime
  endDate      DateTime
  status       PolicyStatus @default(SOUMISE)
  prospectId   String
  agentId      String
  companyId    String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  prospect    Prospect     @relation(fields: [prospectId], references: [id])
  agent       User         @relation(fields: [agentId], references: [id])
  company     Company      @relation(fields: [companyId], references: [id])
  commissions Commission[]
  claims      Claim[]

  @@map("policies")
}

// ─── Commission ───────────────────────────────────────────────────────────────

model Commission {
  id         String           @id @default(cuid())
  amount     Float
  rate       Float
  month      DateTime
  status     CommissionStatus @default(ATTENTE)
  agentId    String
  policyId   String
  approvedBy String?
  companyId  String
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  agent    User    @relation(fields: [agentId], references: [id])
  policy   Policy  @relation(fields: [policyId], references: [id])
  approver User?   @relation("ApprovedCommissions", fields: [approvedBy], references: [id])
  company  Company @relation(fields: [companyId], references: [id])

  @@map("commissions")
}

// ─── Sinistre ─────────────────────────────────────────────────────────────────

model Claim {
  id          String      @id @default(cuid())
  claimNumber String      @unique
  description String
  amount      Float?
  status      ClaimStatus @default(OUVERT)
  policyId    String
  declaredAt  DateTime    @default(now())
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  policy Policy @relation(fields: [policyId], references: [id])

  @@map("claims")
}

// ─── Activité ─────────────────────────────────────────────────────────────────

model Activity {
  id         String       @id @default(cuid())
  type       ActivityType
  note       String?
  prospectId String?
  userId     String
  createdAt  DateTime     @default(now())

  prospect Prospect? @relation(fields: [prospectId], references: [id])
  user     User      @relation(fields: [userId], references: [id])

  @@map("activities")
}

// ─── Snapshot d'activité agent (généré tous les 14 jours) ────────────────────

model AgentSnapshot {
  id          String   @id @default(cuid())
  agentId     String
  companyId   String
  periodStart DateTime
  periodEnd   DateTime
  data        Json
  createdAt   DateTime @default(now())

  agent   User    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("agent_snapshots")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  SUPERADMIN
  MANAGER
  SUPERVISOR
  AGENT
}

enum UserStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  EXPIRED
}

enum ProspectStage {
  CONTACT
  ENTRETIEN
  ENTREVUE
  SOUMISE
  EMISE
  LIVRAISON
}

enum PolicyStatus {
  SOUMISE
  EMISE
  LIVREE
}

enum CommissionStatus {
  ATTENTE
  VALIDE
  PAYE
}

enum ClaimStatus {
  OUVERT
  INSTRUCTION
  CLOS
}

enum ActivityType {
  CONTACT
  ENTRETIEN
  ENTREVUE
  NOTE
  STAGE_CHANGE
}
